{
  "name": "@bml/schemas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/migrate.ts --reset && tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo '(schemas: covered by integration suite)'",
    "dictionary": "tsx src/data-dictionary.ts"
  },
  "dependencies": {
    "@bml/crypto": "workspace:*",
    "@bml/policy": "workspace:*",
    "@bml/synthetic-data": "workspace:*",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
