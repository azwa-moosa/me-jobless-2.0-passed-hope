{
  "name": "@bml/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,api \"tsc -w --preserveWatchOutput -p tsconfig.json\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@bml/crypto": "workspace:*",
    "@bml/policy": "workspace:*",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
